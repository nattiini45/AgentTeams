    {
      "id": "claim_71d34e0f375e48eca448a55e9c230fec",
      "statement": "The gateway handler supports four AI provider endpoints: GET/POST /api/v1/gateway/providers, DELETE /api/v1/gateway/providers/{name}, and GET /api/v1/gateway/providers/{name}/models. Provider registration creates a DNS service source, AI provider, and provider-specific AI route.",
