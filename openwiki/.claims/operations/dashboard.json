    {
      "id": "claim_05a063b90bc4458a816b4bd09aca8447",
      "statement": "Conditional-GET caching on MinIO routes forwards `If-None-Match` and `If-Modified-Since` as unsigned transport headers (never part of the SigV4 signature), relays MinIO 304 as bodyless 304, and on 200 sets `Cache-Control: no-cache` to force revalidation.",
      "evidence": [
        {
          "resource": "repo://dashboard/server/src/handler.js#L136-L194",
          "version": "repo-lines-v1:sha256:58b4868740354343770e35b61edf542577b837a193295801ee3abe2decdebf61:"
