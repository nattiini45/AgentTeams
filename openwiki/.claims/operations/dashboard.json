        }
      ]
    },
    {
      "id": "claim_ffa2773ab7e04ec3af753210eea346ca",
      "statement": "The `/docker/` path (the controller's embedded-mode Docker socket passthrough) is never proxied — it has no route in the allowlist and returns 404.",
      "evidence": [
        {
          "resource": "repo://dashboard/README.md#L91-L93",
          "version": "repo-lines-v1:sha256:e257eebaf9d8ff016ccba0d4136469010f4aca8b7b71a3b82fd6cd2e837ebf25:"
