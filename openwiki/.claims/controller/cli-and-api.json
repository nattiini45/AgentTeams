        }
      ]
    },
    {
      "id": "claim_88dbea746761462dbd940e3aeb155c11",
      "statement": "GET /api/v1/workers/{name}/events returns the worker's bounded event history (newest first) recorded by the health monitor and lifecycle handlers. Events are capped at MaxWorkerRecentEvents.",
