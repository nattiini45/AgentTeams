    {
      "id": "claim_16e950bfc0794ca9aa9967d682d6063e",
      "statement": "The Docker API proxy is registered only in embedded mode (kubeMode=embedded with a non-empty SocketPath). It strips the /docker prefix and delegates to proxy.NewHandler with security validation.",
