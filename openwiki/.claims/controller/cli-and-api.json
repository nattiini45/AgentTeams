    {
      "id": "claim_33fb6e8d532b426a910518641ba4cb17",
      "statement": "Message injection endpoints (POST /api/v1/managers/{name}/message and POST /api/v1/teams/{name}/message) post system-level messages directly into a Manager's Admin DM room or a Team's leader channel, bypassing the normal agent chat loop. For team messages, the endpoint prefers the leader↔admin DM room (Status.LeaderDMRoomID) and falls back to the shared team room (Status.TeamRoomID) when the DM hasn't been provisioned yet.",
      "evidence": [
        {
          "resource": "repo://agentteams-controller/internal/server/message_handler.go#L53-L93",
